# Required. SQLite for local dev; use a postgres:// URL (and provider = "postgresql" in schema.prisma) for deployment.
DATABASE_URL="file:./dev.db"

# Optional. Override the Riftcodex base URL (card data). No key needed.
# RIFTCODEX_BASE_URL="https://api.riftcodex.com"

# Optional, Phase 2+. Paid fallback price source — leave empty to use free tcgcsv.com dumps.
# SCRYDEX_API_KEY=""

# Required when deployed: the sign-in password. `npm run dev` never asks; a production server refuses
# to serve without it unless RIFT_LEDGER_OPEN=1 (trusted local machine only).
# APP_PASSWORD=""
# Signs session cookies. Any long random string (openssl rand -base64 32). Defaults to one derived from APP_PASSWORD.
# AUTH_SECRET=""
# Protects /api/cron/*: callers send `Authorization: Bearer <CRON_SECRET>`. Without it the endpoints only
# run in development or with RIFT_LEDGER_OPEN=1.
# CRON_SECRET=""
# RIFT_LEDGER_OPEN="1"
